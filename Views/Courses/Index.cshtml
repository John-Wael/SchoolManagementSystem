@model IEnumerable<SchoolManagementSystem.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="admin-header">
    <h2>📚 Courses</h2>
    <a asp-action="Create" class="create-btn">➕ Create New</a>
</div>

@if (!Model.Any())
{
    <div class="admin-empty">
        <div class="icon">📚</div>
        <h4>No courses yet</h4>
    </div>
}
else
{
    <div class="admin-table-container">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Course Code</th>
                    <th>Title</th>
                    <th>Credits</th>
                    <th>Max Students</th>
                    <th>Active</th>
                    <th>Enrollment</th>
                    <th>Department</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.CourseCode</strong></td>
                        <td>@item.Title</td>
                        <td><span class="custom-badge badge-dept">@item.Credits</span></td>
                        <td>@item.MaxStudents</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="custom-badge badge-open">✅ Active</span>
                            }
                            else
                            {
                                <span class="custom-badge badge-closed">❌ Inactive</span>
                            }
                        </td>
                        <td>
                            @if (item.IsEnrollmentOpen)
                            {
                                <span class="custom-badge badge-open">🟢 Open</span>
                            }
                            else
                            {
                                <span class="custom-badge badge-closed">🔴 Closed</span>
                            }
                        </td>
                        <td>@item.Department?.Name</td>
                        <td>
                            <a asp-action="Edit" asp-route-courseId="@item.CourseId" class="btn btn-sm btn-outline-warning action-btn-sm">✏️ Edit</a>
                            <a asp-action="Details" asp-route-courseId="@item.CourseId" class="btn btn-sm btn-outline-info action-btn-sm">🔍 Details</a>
                            <a asp-action="Delete" asp-route-courseId="@item.CourseId" class="btn btn-sm btn-outline-danger action-btn-sm">🗑️ Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
