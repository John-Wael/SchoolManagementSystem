@model SchoolManagementSystem.Models.Enrollment

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3 class="text-danger">Are you sure you want to delete this?</h3>
<div>
    <h4>Enrollment</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Student</dt>
        <dd class="col-sm-9">@Model?.Student?.StudentNumber - @Model?.Student?.LastName, @Model?.Student?.FirstName</dd>

        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@Model?.Course?.Title</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Semester)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Semester)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.AcademicYear)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.AcademicYear)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EnrolledOn)</dt>
        <dd class="col-sm-9">@Model?.EnrolledOn.ToString("yyyy-MM-dd")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="EnrollmentId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>