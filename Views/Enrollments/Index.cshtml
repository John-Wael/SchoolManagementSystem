@model IEnumerable<SchoolManagementSystem.Models.Enrollment>

@{
    ViewData["Title"] = "Enrollments";
}

<div class="admin-header">
    <h2>📝 Enrollments</h2>
    <a asp-action="Create" class="create-btn">➕ Create New</a>
</div>

@if (!Model.Any())
{
    <div class="admin-empty">
        <div class="icon">📝</div>
        <h4>No enrollments yet</h4>
    </div>
}
else
{
    <div class="admin-table-container">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Semester</th>
                    <th>Academic Year</th>
                    <th>Enrolled On</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Student?.StudentNumber</strong> - @item.Student?.FirstName @item.Student?.LastName</td>
                        <td>@item.Course?.Title</td>
                        <td><span class="custom-badge badge-semester">@item.Semester</span></td>
                        <td>@item.AcademicYear</td>
                        <td>@item.EnrolledOn.ToString("yyyy-MM-dd")</td>
                        <td>
                            <a asp-action="Edit" asp-route-enrollmentId="@item.EnrollmentId" class="btn btn-sm btn-outline-warning action-btn-sm">✏️ Edit</a>
                            <a asp-action="Details" asp-route-enrollmentId="@item.EnrollmentId" class="btn btn-sm btn-outline-info action-btn-sm">🔍 Details</a>
                            <a asp-action="Delete" asp-route-enrollmentId="@item.EnrollmentId" class="btn btn-sm btn-outline-danger action-btn-sm">🗑️ Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
