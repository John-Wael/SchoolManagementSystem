@model SchoolManagementSystem.Models.Attendance

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Attendance</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Student</dt>
        <dd class="col-sm-10">@Model?.Enrollment?.Student?.StudentNumber - @Model?.Enrollment?.Student?.LastName, @Model?.Enrollment?.Student?.FirstName</dd>

        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Model?.Enrollment?.Course?.Title (@Model?.Enrollment?.Semester @Model?.Enrollment?.AcademicYear)</dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AttendanceDate)
        </dt>
        <dd class="col-sm-10">
            @Model?.AttendanceDate.ToString("yyyy-MM-dd")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-attendanceid="@Model?.AttendanceId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>