@model IEnumerable<SchoolManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="admin-header">
    <h2>👨‍🎓 Students</h2>
    <a asp-action="Create" class="create-btn">➕ Create New</a>
</div>

@if (!Model.Any())
{
    <div class="admin-empty">
        <div class="icon">👨‍🎓</div>
        <h4>No students yet</h4>
    </div>
}
else
{
    <div class="admin-table-container">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Student Number</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Date of Birth</th>
                    <th>Active</th>
                    <th>Department</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.StudentNumber</strong></td>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@(item.DateOfBirth?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="custom-badge badge-open">✅ Active</span>
                            }
                            else
                            {
                                <span class="custom-badge badge-closed">❌ Inactive</span>
                            }
                        </td>
                        <td>@item.Department?.Name</td>
                        <td>
                            <a asp-action="Edit" asp-route-studentId="@item.StudentId" class="btn btn-sm btn-outline-warning action-btn-sm">✏️ Edit</a>
                            <a asp-action="Details" asp-route-studentId="@item.StudentId" class="btn btn-sm btn-outline-info action-btn-sm">🔍 Details</a>
                            <a asp-action="Delete" asp-route-studentId="@item.StudentId" class="btn btn-sm btn-outline-danger action-btn-sm">🗑️ Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
