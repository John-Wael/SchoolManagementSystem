@model SchoolManagementSystem.Models.ViewModels.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Teacher Dashboard";
}

<style>
    .teacher-header {
        background: linear-gradient(135deg, #4facfe, #00f2fe);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 25px;
        box-shadow: 0 8px 25px rgba(79, 172, 254, 0.4);
        position: relative;
        overflow: hidden;
    }

    .teacher-header::before {
        content: "👨‍🏫";
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 120px;
        opacity: 0.15;
    }

    .teacher-header h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
    }

    .teacher-header p {
        margin: 8px 0 0 0;
        opacity: 0.9;
        font-size: 16px;
    }

    .course-table-container {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .course-table {
        margin: 0;
    }

    .course-table thead {
        background: linear-gradient(135deg, #4facfe, #00f2fe);
        color: white;
    }

    .course-table thead th {
        border: none;
        padding: 15px;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.5px;
    }

    .course-table tbody tr {
        transition: background 0.2s ease;
    }

    .course-table tbody tr:hover {
        background: #f0f9ff;
    }

    .course-table tbody td {
        padding: 15px;
        vertical-align: middle;
        border-color: #f0f0f0;
    }

    .action-btn {
        border-radius: 20px;
        padding: 5px 15px;
        font-size: 12px;
        font-weight: 600;
        transition: all 0.2s ease;
        border-width: 2px;
        margin-right: 3px;
        margin-bottom: 3px;
    }

    .action-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: linear-gradient(135deg, #f0f9ff, #e0f2ff);
        border-radius: 15px;
        border: 2px dashed #a8d5ff;
    }

    .empty-state .icon {
        font-size: 80px;
        margin-bottom: 20px;
    }
</style>

<div class="teacher-header">
    <h1>Welcome, @Model.TeacherName! 👋</h1>
    <p>Manage your courses, grades, and students from here</p>
</div>

@if (!Model.IsLinked)
{
    <div class="alert alert-warning">
        ⚠️ Your account isn't linked to a Teacher record yet. Contact an Admin to link your login
        to your Teacher profile so your courses can show up here.
    </div>
}
else
{
    @if (!Model.Courses.Any())
    {
        <div class="empty-state">
            <div class="icon">📭</div>
            <h4>You aren't assigned to any courses yet</h4>
            <p class="text-muted">Contact an Admin to assign you to courses</p>
        </div>
    }
    else
    {
        <h3 class="mb-3">📚 My Courses</h3>
        <div class="course-table-container">
            <table class="table course-table">
                <thead>
                    <tr>
                        <th>Course Code</th>
                        <th>Title</th>
                        <th>Role</th>
                        <th>Enrolled</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Courses)
                    {
                        <tr>
                            <td><strong>@c.CourseCode</strong></td>
                            <td>@c.Title</td>
                            <td>
                                @if (c.IsPrimary)
                                {
                                    <span class="badge bg-success">Primary</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Assistant</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-info">@c.EnrolledCount@(c.MaxStudents.HasValue ? $" / {c.MaxStudents}" : "")</span>
                            </td>
                            <td>
                                <a asp-controller="Dashboard" asp-action="CourseDetails" asp-route-courseId="@c.CourseId" class="btn btn-sm btn-outline-dark action-btn">📋 Details</a>
                                <a asp-controller="Grades" asp-action="Index" asp-route-courseId="@c.CourseId" class="btn btn-sm btn-outline-primary action-btn">📊 Grades</a>
                                <a asp-controller="Attendance" asp-action="Index" asp-route-courseId="@c.CourseId" class="btn btn-sm btn-outline-secondary action-btn">📅 Attendance</a>
                                <a asp-controller="Lessons" asp-action="Index" asp-route-courseId="@c.CourseId" class="btn btn-sm btn-outline-info action-btn">📹 Lessons</a>
                                <a asp-controller="Quizzes" asp-action="Index" asp-route-courseId="@c.CourseId" class="btn btn-sm btn-outline-warning action-btn">📝 Quizzes</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
